# 依赖目录
/vendor/
node_modules/

# 敏感配置
config.php
install-config.json

# 日志和缓存
/storage/logs/*.log
/storage/cache/*
/storage/sessions/*
/storage/tmp/*
/storage/views/*
/storage/formatter/*
/storage/less/*
/storage/locale/*

# Flarum Agents 敏感信息
/flarum-agents/config/agents.php
/flarum-agents/runtime/*.json
/flarum-agents/runtime/*.log

# 上传的文件
/public/assets/avatars/*

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.temp
/tmp/
/temp/

# 论文预印本（大文件，不同步）
/flarum-agents/preprints/daily_papers/**/*.pdf
/flarum-agents/preprints/metadata/*.json
/flarum-agents/preprints/interpreted/*.json
/flarum-agents/preprints/paper_queue.json
/flarum-agents/preprints/pdf/*.pdf
